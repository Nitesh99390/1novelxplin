# --- required ---
BOT_TOKEN=123456:ABC-your-token-from-BotFather
# Public https URL of this server (webhook + Mini App). Empty = long polling, no Mini App buttons.
PUBLIC_URL=https://your-app.onrender.com

# --- optional ---
PORT=3000
WEBHOOK_SECRET=some-long-random-string
DB_PATH=data/bot.db
# Telegram user IDs of bot admins (comma separated) — can manage every chat
ADMIN_IDS=
# Short name from BotFather /newapp → enables direct links t.me/<bot>/<name>?startapp=c_<slug>
MINIAPP_SHORT_NAME=
# One-time invite link lifetime in hours
LINK_TTL_HOURS=24
# "Membership ends soon" reminder, hours before expiry
REMIND_HOURS=24
# How often the countdown scheduler runs (seconds)
SCHEDULER_SECONDS=30
MAX_STARS=10000
MAX_DAYS=3650
# Local browser testing only: lets ?dev=<telegram id> act as that user. NEVER enable in production.
DEV_AUTH=0
